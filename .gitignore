# gitignore for Interactive Voice AI

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Environment files
.env
backend/.env
frontend/.env

# Generated audio (auto-cleaned by backend)
backend/generated_audio/*.wav
backend/generated_audio/*.mp3
backend/temp_audio/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Piper voice models (large binary files)
backend/voices/*.onnx

# Pytest
.pytest_cache/
