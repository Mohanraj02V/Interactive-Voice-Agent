# Application
APP_NAME=Interactive Voice AI
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Whisper Speech-to-Text
# Models: tiny, base, small, medium, large
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT=120

# Piper TTS
# Path to the .onnx voice model file
PIPER_MODEL=voices/en_US-lessac-medium.onnx
# Name or path to the piper executable
PIPER_EXECUTABLE=piper

# Audio Settings
MAX_AUDIO_SIZE_MB=25
MAX_CONVERSATION_MESSAGES=20

# Audio directories (relative to backend/)
GENERATED_AUDIO_DIR=generated_audio
TEMP_AUDIO_DIR=temp_audio
AUDIO_RETENTION_MINUTES=60
